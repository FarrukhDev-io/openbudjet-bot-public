# ==============================================================================
# OpenBudjet Bot - Environment Variables Template
# ==============================================================================

# Telegram Bot tokeningiz (t.me/BotFather orqali olinadi)
# MAJBURIY!
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Super Admin Telegram ID (Boshqaruvchi asosiy admin)
# MAJBURIY!
SUPER_ADMIN_ID=987654321

# Barcha adminlarning Telegram IDlari (vergul bilan ajratilgan holda)
# MAJBURIY!
ADMIN_IDS=987654321,123456789

# PostgreSQL Ma'lumotlar bazasi ulanish manzili (Connection URL)
# Ixtiyoriy (default: postgresql://postgres:postgres@localhost:5432/openbudget)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openbudget

# Redis ulanish manzili (OTP cheklovlari va locklar uchun)
# Ixtiyoriy (default: redis://localhost:6379/0)
REDIS_URL=redis://localhost:6379/0

# Muhit turi (production / development)
# Ixtiyoriy (default: production)
ENVIRONMENT=production

# API server port raqami
# Ixtiyoriy (default: 8000)
PORT=8000

# Mini App WebApp URL (Mini App yuklanadigan manzil)
# Ixtiyoriy (default: http://localhost:8000)
WEBAPP_URL=http://localhost:8000

# Open Budget loyiha UUID va Ommaviy (Public) IDsi
# Ixtiyoriy (default qiymatlar mavjud)
INITIATIVE_UUID=49912c4c-d184-4112-81b4-9a809d841845
INITIATIVE_PUB_ID=055521975013

# Ovoz berish muddati
# Ixtiyoriy (default: 2026-08-22 dan 2026-08-31 gacha)
VOTING_START=2026-08-22
VOTING_END=2026-08-31

# Foydalanuvchi va taklif qilgan odam uchun mukofotlar miqdori (so'mda)
# Ixtiyoriy (default: 15000 va 5000)
REWARD_AMOUNT=15000
REFERRAL_REWARD=5000

# Aloqa uchun admin va dasturchi kontaktlari
# Ixtiyoriy (default qiymatlar mavjud)
ADMIN_PHONE=+998943238586
ADMIN_TELEGRAM=@joshqinjumayev
DEVELOPER_TELEGRAM=@sadullaef_06
